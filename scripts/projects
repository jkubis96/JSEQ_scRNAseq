#!/bin/bash

function merge_fq {

	if ((samples > 1)); then
		for ((g = 1; g <= samples; g++)); do

			fq=$(pwd)/projects/$project_name_mod/sample_$g/fast_data/*.fastq.gz

			r1=()
			r2=()

			for i in $fq; do
				if [[ "$i" == *"R1"* ]]; then
					r1+=("$(basename "$i")")
				elif [[ "$i" == *"R2"* ]]; then
					r2+=("$(basename "$i")")
				fi
			done

			cd "projects/$project_name_mod/sample_$g/fast_data" || return 1

			if [[ ${#r1[@]} -eq 1 && "${r1[0]}" == "input_R1.fastq.gz" ]]; then
				echo "R1 is already merged: input_R1.fastq.gz"
			else
				cat "${r1[@]}" >input_R1.fastq.gz
				rm "${r1[@]}"
			fi

			if [[ ${#r2[@]} -eq 1 && "${r2[0]}" == "input_R2.fastq.gz" ]]; then
				echo "R2 is already merged: input_R2.fastq.gz"
			else
				cat "${r2[@]}" >input_R2.fastq.gz
				rm "${r2[@]}"
			fi

			cd ../../../..

		done

	else

		fq=$(pwd)/projects/$project_name_mod/fast_data/*.fastq.gz

		r1=()
		r2=()

		for i in $fq; do
			if [[ "$i" == *"R1"* ]]; then
				r1+=("$(basename "$i")")
			elif [[ "$i" == *"R2"* ]]; then
				r2+=("$(basename "$i")")
			fi
		done

		cd "projects/$project_name_mod/fast_data" || return 1

		if [[ ${#r1[@]} -eq 1 && "${r1[0]}" == "input_R1.fastq.gz" ]]; then
			echo "R1 is already merged: input_R1.fastq.gz"
		else
			cat "${r1[@]}" >input_R1.fastq.gz
			rm "${r1[@]}"
		fi

		if [[ ${#r2[@]} -eq 1 && "${r2[0]}" == "input_R2.fastq.gz" ]]; then
			echo "R2 is already merged: input_R2.fastq.gz"
		else
			cat "${r2[@]}" >input_R2.fastq.gz
			rm "${r2[@]}"
		fi

		cd ../../..

	fi

}

function checkfq {

	echo ''

	if ((samples > 1)); then
		for ((i = 1; i <= samples; i++)); do
			echo -e '\033[1;36m Put fastq data into => projects/'$project_name_mod'/sample_'$i/'fast_data'
		done
	else
		echo -e '\033[1;36m Put fastq data into => projects/'$project_name_mod/'fast_data'

	fi

	echo -e '\033[1;36m If you did it, push ENTER'
	echo -e '\033[1;36m If you want to quit write "q" and push ENTER'

	read enter
	enter=$(echo $enter | tr '[:upper:]' '[:lower:]')

	if [[ $enter == "q" ]]; then
		rm -rf "$(pwd)/projects/$project_name_mod"
		PROJECT
	fi

	all_decision=true
	if ((samples > 1)); then

		for ((i = 1; i <= samples; i++)); do

			BASE_DIR="$(pwd)/projects/$project_name_mod/sample_$i"

			r=""
			for fast in "$BASE_DIR"/fast_data/*.fastq.gz; do
				r+="$fast "
			done

			if [[ "$r" == *"R1"* ]] && [[ "$r" == *"R2"* ]]; then
				decision=true
			else
				decision=false
				echo -e "\033[0;31m Missing R1 or R2 file in Sample_$i"
			fi

			if [[ "$decision" == false ]]; then
				all_decision=false
			fi

		done

	else

		echo -e '\033[1;36m Put fastq data into => projects/'$project_name_mod/'fast_data'
		BASE_DIR=$(pwd)/projects/$project_name_mod/fast_data/*.fastq.gz

		r=""
		for fast in $BASE_DIR; do
			r+="$fast "
		done

		if [[ "$r" == *"R1"* ]] && [[ "$r" == *"R2"* ]]; then
			decision=true
		else
			decision=false
		fi

		if [[ "$decision" == false ]]; then
			all_decision=false
		fi

	fi

	if [[ $all_decision == true ]]; then
		echo ''
		echo -e "\033[0;32m Project done"
		echo ''
		echo -e '\033[1;36m Merge fastq file for Read1 and Read2 - if more than one'
		echo ''
		merge_fq
		echo ''
		source=$(pwd)/scripts/genome_indexing
		source $source
		INDEXING

	else
		echo -e '\033[0;31m Fastq data not found'
		echo -e '\033[0;31m Put data'
		checkfq

	fi

}

function checkseurat_1 {

	echo ''

	if ((samples > 1)); then
		for ((i = 1; i <= samples; i++)); do
			echo -e '\033[1;36m Put data matrix into => projects/'$project_name_mod'/sample_'$i/'sc_data'

		done
	else
		echo -e '\033[1;36m Put data matrix into => projects/'$project_name_mod/'sc_data'

	fi

	echo -e '\033[1;36m Available matrix format .csv | .tsv | .txt'
	echo -e '\033[1;36m If you did it, push ENTER'
	echo -e '\033[1;36m If you want to quit write "q" and push ENTER'

	read enter
	enter=$(echo $enter | tr '[:upper:]' '[:lower:]')

	if [[ $enter == "q" ]]; then
		rm -rf "$(pwd)/projects/$project_name_mod"
		PROJECT
	fi

	all_decision=true
	if ((samples > 1)); then

		for ((g = 1; g <= samples; g++)); do

			fast=$(pwd)'/projects/'$project_name_mod'/sample_'$g'/sc_data/*'

			for i in $fast; do
				r+=$i
			done

			if [[ $r == *".tsv"* ]]; then

				echo -e "\033[1;36m $(date) Data converting"

				format=tsv
				con=NULL
				null=NULL
				converter=$(pwd)/scripts/converter.R
				Rscript $converter $format $(pwd)'/projects/'$project_name_mod'/sample_'$g'/sc_data/' $(basename $r) $null $con

			elif [[ $r == *".csv"* ]]; then
				echo -e "\033[1;36m $(date) Data converting"

				format=csv
				con=NULL
				null=NULL
				converter=$(pwd)/scripts/converter.R
				Rscript $converter $format $(pwd)'/projects/'$project_name_mod'/sample_'$g'/sc_data/' $(basename $r) $null $con

				echo ''
				echo -e "\033[0;32m Project done"
				echo -e "\033[0;32m Start analysis"
				echo ''

			elif [[ $r == *".txt"* ]]; then

				echo -e "\033[1;36m $(date) Data converting"

				format=txt
				con=NULL
				null=NULL
				converter=$(pwd)/scripts/converter.R
				Rscript $converter $format $(pwd)'/projects/'$project_name_mod'/sample_'$g'/sc_data/' $(basename $r) $null $con

				echo ''
				echo -e "\033[0;32m Project done"
				echo -e "\033[0;32m Start analysis"
				echo ''

			else
				all_decision=false
				echo -e "\033[0;31m Missing expression matrix file in Sample_$g"

			fi

		done

	else

		fast=$(pwd)/projects/$project_name_mod/sc_data/*

		for i in $fast; do
			r+=$i
		done

		if [[ $r == *".tsv"* ]]; then

			echo -e "\033[1;36m $(date) Data converting"

			format=tsv
			con=NULL
			null=NULL
			converter=$(pwd)/scripts/converter.R
			Rscript $converter $format $(pwd)/projects/$project_name_mod/sc_data/ $(basename $r) $null $con

		elif [[ $r == *".csv"* ]]; then
			echo -e "\033[1;36m $(date) Data converting"

			format=csv
			con=NULL
			null=NULL
			converter=$(pwd)/scripts/converter.R
			Rscript $converter $format $(pwd)/projects/$project_name_mod/sc_data/ $(basename $r) $null $con

			echo ''
			echo -e "\033[0;32m Project done"
			echo -e "\033[0;32m Start analysis"
			echo ''

		elif [[ $r == *".txt"* ]]; then

			echo -e "\033[1;36m $(date) Data converting"

			format=txt
			con=NULL
			null=NULL
			converter=$(pwd)/scripts/converter.R
			Rscript $converter $format $(pwd)/projects/$project_name_mod/sc_data/ $(basename $r) $null $con

			echo ''
			echo -e "\033[0;32m Project done"
			echo -e "\033[0;32m Start analysis"
			echo ''

		else
			all_decision=false

		fi

	fi

	if [[ $all_decision == true ]]; then
		echo ''
		echo -e "\033[0;32m Project done"
		echo -e "\033[0;32m Run analysis"
		echo ''

		start

	else
		echo -e '\033[1;31m Expression data not found'
		echo -e '\033[1;31m Put data'
		checkseurat_1

	fi

}

function checkseurat_3 {
	echo ''

	if ((samples > 1)); then
		for ((i = 1; i <= samples; i++)); do
			echo -e '\033[1;36m Put data matrix into => projects/'$project_name_mod'/sample_'$i/'sc_data'

		done
	else
		echo -e '\033[1;36m Put data matrix into => projects/'$project_name_mod/'sc_data'

	fi

	echo -e '\033[1;36m Available matrix format .csv | .tsv | .txt'
	echo -e '\033[1;36m If you did it, push ENTER'
	echo -e '\033[1;36m If you want to quit write "q" and push ENTER'

	read enter
	enter=$(echo $enter | tr '[:upper:]' '[:lower:]')

	if [[ $enter == "q" ]]; then
		rm -rf "$(pwd)/projects/$project_name_mod"
		PROJECT
	fi

	all_decision=true
	if ((samples > 1)); then

		for ((g = 1; g <= samples; g++)); do

			fast=$(pwd)'/projects/'$project_name_mod'/sample_'$g'/sc_data/*'

			for i in $fast; do
				r+=$i
			done

			if [[ $r == *"matrix"* ]] && [[ $r == *"genes"* ]] && [[ $r == *"barcodes"* ]]; then

				echo ''
				echo -e "\033[0;32m Project done"
				echo -e "\033[0;32m Start analysis"
				echo ''

				start

			else

				all_decision=false
				echo -e "\033[0;31m Missing expression matrix file in Sample_$g"

			fi

		done

	else

		fast=$(pwd)/projects/$project_name_mod/sc_data/*

		for i in $fast; do
			r+=$i
		done

		if [[ $r == *"matrix"* ]] && [[ $r == *"genes"* ]] && [[ $r == *"barcodes"* ]]; then

			echo ''
			echo -e "\033[0;32m Project done"
			echo -e "\033[0;32m Start analysis"
			echo ''

			start

		else

			all_decision=false

		fi

	fi

	if [[ $all_decision == true ]]; then
		echo ''
		echo -e "\033[0;32m Project done"
		echo -e "\033[0;32m Run analysis"
		echo ''

		start

	else
		echo -e '\033[0;31m Expression data not found'
		echo -e '\033[0;31m Put data'
		checkseurat_3

	fi

}

function PARAMETRS_fq {
	echo -e '\033[1;36m Project name:'
	echo -e '\033[1;36m If quit [q]:'

	echo ''
	read project_name
	project_name=$(echo $project_name | tr '[:upper:]' '[:lower:]')

	if [ -z $project_name ]; then

		project_name=_

	fi

	if [ $project_name == q ]; then

		start

	else

		echo -e '\033[1;36m Enter operation paramets:'
		echo ''
		echo -e '\033[1;36m ReadsLenght:'
		echo ''
		read READS_LENGHT

		echo -e '\033[1;36m Genome [select number]:'
		echo ''
		genomes=("$(pwd)"/genome/*)

		if [[ "${genomes[0]}" == "$(pwd)/genome/*" ]]; then
			genomes=()
		fi

		select d in "${genomes[@]}" Back; do
			if [[ -n "$d" ]]; then
				species=$(basename "$d")
				break
			else
				echo -e "\033[0;31m >>> Invalid Selection"
			fi
		done

		if [[ "$d" == "Back" ]]; then
			species=_
			start
		fi

		echo -e '\033[1;36m Estimated number of cells'
		echo ''
		read cell

		echo -e '\033[1;36m Select marker set'
		echo ''

		marker_input=("$(pwd)/requirements_file/"*.xlsx)

		if [[ ${marker_input[0]} == "$(pwd)/requirements_file/*.xlsx" ]]; then
			marker_input=()
		fi

		if [[ ${#marker_input[@]} -eq 0 ]]; then
			echo ">>> No XLSX files found!"
			exit 1
		fi

		select m in "${marker_input[@]}"; do
			if [[ -n "$m" ]]; then
				marker_path="$m"
				break
			else
				echo ">>> Invalid Selection"
			fi
		done

		echo -e '\033[1;36m Number of samples / repeats'
		echo ''
		read samples

		echo ''
		echo ''

		if [[ $READS_LENGHT -lt 1000 && $READS_LENGHT -gt 0 ]] && [[ $cell -lt 1000000 && $cell -gt 0 ]] && [[ $samples -lt 20 && $samples -gt 0 ]]; then

			echo -e "\033[0;32m Parametrs correct"
			echo ''
		else
			echo ''
			echo -e '\033[0;31m Wrong parametrs'
			echo -e '\033[0;31m Write right parametrs'
			echo ''
			PARAMETRS_fq

		fi

	fi

}

function PARAMETRS_se {
	echo -e '\033[1;36m Project name:'
	echo -e '\033[1;36m If quit [q]:'
	echo ''

	read project_name
	project_name=$(echo $project_name | tr '[:upper:]' '[:lower:]')

	if [ -z $project_name ]; then

		project_name=_

	fi

	if [ $project_name == q ]; then

		start

	else

		echo -e '\033[1;36m Enter operation paramets:'
		echo ''

		echo -e '\033[1;36m Species [human/mice/*custom name*]:'
		echo ''
		read species
		species=$(echo $species | tr '[:upper:]' '[:lower:]')

		echo -e '\033[1;36m Estimated number of cells'
		echo ''
		read cell

		echo -e '\033[1;36m Select marker set'
		echo ''

		marker_input=("$(pwd)/requirements_file/"*.xlsx)

		if [[ ${marker_input[0]} == "$(pwd)/requirements_file/*.xlsx" ]]; then
			marker_input=()
		fi

		if [[ ${#marker_input[@]} -eq 0 ]]; then
			echo ">>> No XLSX files found!"
			exit 1
		fi

		select m in "${marker_input[@]}"; do
			if [[ -n "$m" ]]; then
				marker_path="$m"
				break
			else
				echo ">>> Invalid Selection"
			fi
		done

		echo -e '\033[1;36m Number of samples / repeats'
		echo ''
		read samples

		echo ''
		echo ''

		echo -e '\033[1;36m Data format:\n  [1] count_matrix\n  [2] normalized_expression matrix\n  [3] separate matrix - genes.tsv / names.tsv / matrix.mtx files'

		echo ''
		read data

		if [[ $cell -lt 1000000 && $cell -gt 0 ]] && [[ $data == '1' || $data == '2' || $data == '3' ]] && [[ $samples -lt 20 && $samples -gt 0 ]]; then

			echo -e "\033[0;32m Parametrs correct"
			echo ''
		else
			echo ''
			echo -e '\033[0;31m Wrong parametrs'
			echo -e '\033[0;31m Write right parametrs'
			echo ''
			PARAMETRS_se
		fi
	fi

}

function data_select {

	if [[ $data = 1 ]]; then
		checkseurat_1
	elif [[ $data = 2 ]]; then
		checkseurat_1
	elif [[ $data = 3 ]]; then
		checkseurat_3
	fi
}

function PROJECT {

	echo -e '\033[1;36m Create project for:\n  [1] fastq data\n  [2] counts / expression data\n\n  <<<\n  [b] back'

	read p
	p=$(echo $p | tr '[:upper:]' '[:lower:]')

	if [[ $p == '2' ]]; then
		PARAMETRS_se

		project_name_mod=$(date +'%d-%m-%Y')'_'$project_name'_exp'
		mkdir -p projects/$project_name_mod
		mkdir -p projects/$project_name_mod/results

		if ((samples > 1)); then
			for ((i = 1; i <= samples; i++)); do
				BASE_DIR="projects/$project_name_mod/sample_$i"
				mkdir -p "$BASE_DIR/sc_data"

			done
		else
			BASE_DIR="projects/$project_name_mod"
			mkdir -p "$BASE_DIR/sc_data"
		fi

		echo ''
		echo -e "\033[0;32m Complete"
		echo ''
		echo -e '\033[1;36m Next step =>'
		echo ''

		echo project_name=$project_name >$(pwd)/projects/$project_name_mod/config
		echo project_name_mode=$project_name_mod >>$(pwd)/projects/$project_name_mod/config
		echo species=$species >>$(pwd)/projects/$project_name_mod/config
		echo cell=$cell >>$(pwd)/projects/$project_name_mod/config
		echo data=$data >>$(pwd)/projects/$project_name_mod/config
		echo marker_path=$marker_path >>$(pwd)/projects/$project_name_mod/config
		echo samples=$samples >>$(pwd)/projects/$project_name_mod/config

		data_select

	elif [[ $p == '1' ]]; then

		PARAMETRS_fq

		project_name_mod=$(date +'%d-%m-%Y')'_'$project_name'_fq'
		mkdir -p projects/$project_name_mod
		mkdir -p projects/$project_name_mod/results

		if ((samples > 1)); then
			for ((i = 1; i <= samples; i++)); do
				BASE_DIR="projects/$project_name_mod/sample_$i"

				mkdir -p "$BASE_DIR/tmp"
				mkdir -p "$BASE_DIR/results"
				mkdir -p "$BASE_DIR/fast_data"
			done
		else
			BASE_DIR="projects/$project_name_mod"

			mkdir -p "$BASE_DIR/tmp"
			mkdir -p "$BASE_DIR/fast_data"
		fi

		echo ''
		echo -e "\033[0;32m Complete"
		echo ''
		echo -e '\033[1;36m Next step =>'
		echo ''

		echo project_name=$project_name >$(pwd)/projects/$project_name_mod/config
		echo project_name_mode=$project_name_mod >>$(pwd)/projects/$project_name_mod/config
		echo READS_LENGHT=$READS_LENGHT >>$(pwd)/projects/$project_name_mod/config
		echo species=$species >>$(pwd)/projects/$project_name_mod/config
		echo cell=$cell >>$(pwd)/projects/$project_name_mod/config
		echo data=$data >>$(pwd)/projects/$project_name_mod/config
		echo marker_path=$marker_path >>$(pwd)/projects/$project_name_mod/config
		echo samples=$samples >>$(pwd)/projects/$project_name_mod/config

		checkfq

	elif [[ $p == 'b' ]]; then

		start

	else
		PROJECT
	fi

}
